# OfflineMind Environment Configuration

# Paths
OFFLINEMIND_DATA_DIR=data
OFFLINEMIND_DB_PATH=data/offlinemind.db
OFFLINEMIND_BACKUP_DIR=data/backups

# Connectivity & Sync
OFFLINEMIND_CHECK_INTERVAL=5.0
OFFLINEMIND_PROBE_TIMEOUT=2.0
OFFLINEMIND_AUTO_SYNC=true
OFFLINEMIND_ALLOW_INSECURE_HTTP=true
OFFLINEMIND_SYNC_TIMEOUT=10.0
OFFLINEMIND_MAX_BACKUPS=10

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT=15.0

# Mock Server (for offline testing & demo)
MOCK_SERVER_HOST=127.0.0.1
MOCK_SERVER_PORT=8765

# Logging
OFFLINEMIND_LOG_LEVEL=INFO
